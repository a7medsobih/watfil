# Backend base URL (include /api if your backend mounts routes under it)
# REQUIRED on Vercel for Production + Preview + Development.
# NEXT_PUBLIC_* values are inlined at build time — redeploy after changing.
# Browser requests are proxied via /api/backend to avoid Laravel Sanctum CSRF 419.
NEXT_PUBLIC_API_URL=

# Public site origin used for canonical URLs / Open Graph / robots (no trailing slash)
# e.g. https://watfil.com
NEXT_PUBLIC_SITE_URL=

# Optional: verbose API timing logs in production Function Logs
# API_DEBUG=1
